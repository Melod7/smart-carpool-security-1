# =============================================================================
# Kubix — variables de entorno (única fuente de verdad)
# Copiar a .env:  cp .env.example .env
# Regenerar derivados (web/.env, Maps iOS/web):  make sync-env
# =============================================================================

# --- Postgres ---
POSTGRES_DB=kubix
POSTGRES_USER=kubix
POSTGRES_PASSWORD=kubix
POSTGRES_PORT=55432

# --- API ---
API_PORT=8080
# URL que usan web admin y docs (localhost desde el host).
API_URL=http://localhost:8080
MIGRATE_ON_STARTUP=true
SEED_ON_STARTUP=true

# --- Web admin (Vite) — puerto fijo ---
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173

# --- Mobile (Flutter) ---
# Puerto fijo de Flutter web (Chrome). Evita CORS por puertos efímeros.
FLUTTER_WEB_PORT=5055
FLUTTER_WEB_ORIGIN=http://localhost:5055
# Déjalo vacío: `make mobile` elige 10.0.2.2 / 127.0.0.1 / IP LAN según el device.
# Ejemplo físico: http://192.168.1.180:8080
MOBILE_API_URL=
# Device Flutter (-d). Vacío = el que elija Flutter / el primero.
MOBILE_DEVICE=

# --- Google Maps (UNA sola clave para API Directions + web Maps JS + mobile SDK) ---
GOOGLE_MAPS_API_KEY=

# --- Seed super_admin ---
SUPER_ADMIN_EMAIL=superadmin@kubix.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- pgAdmin (make tools / docker compose --profile tools) ---
PGADMIN_EMAIL=admin@kubix.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
