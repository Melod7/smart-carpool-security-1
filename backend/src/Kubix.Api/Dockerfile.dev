FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

# Restore cache layer (el volumen de compose sobreescribe el código en runtime)
COPY backend/ ./
RUN dotnet restore src/Kubix.Api/Kubix.Api.csproj

ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_WATCH_SUPPRESS_BROWSER_REFRESH=1
EXPOSE 8080

ENTRYPOINT ["dotnet", "watch", "run", "--project", "src/Kubix.Api/Kubix.Api.csproj", "--urls", "http://0.0.0.0:8080"]
